---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { GITHUB_ORG, DOCS, CONTACT, orgSchema, websiteSchema, breadcrumbSchema } from '../data/site.js';

const title = 'FAQ — dotcommoners open-source infrastructure';
const description =
  'Common questions about dotcommoners: what it is, whether it is really MIT-licensed, how to self-host the projects, and how to contribute.';
const keywords = [
  'dotcommoners faq', 'is dotcommoners open source', 'self-host', 'MIT license',
  'machineuse', 'revenprox', 'contribute', 'vs SaaS',
];

const crumbs = [
  { name: 'Home', href: '/' },
  { name: 'FAQ', href: '/faq' },
];

// Rich, high-intent Q&As. Answers double as GEO-extractable snippets and as FAQPage JSON-LD.
const faqs = [
  {
    q: 'What is dotcommoners?',
    a: 'dotcommoners is an open-source organization building high-performance, self-hostable infrastructure and systems software. It rebuilds the infrastructure most teams rent — orchestration, streaming, browser automation, observability — as MIT-licensed software you own and operate on your own hardware. Public projects include Machineuse and RevenProx.',
  },
  {
    q: 'Is dotcommoners really open source and MIT-licensed?',
    a: 'Yes. Every dotcommoners project is released under the permissive MIT license. You can read the full source on GitHub at github.com/dotcommoners, fork it, modify it, and run it in production with no proprietary control plane and no licensing fees.',
  },
  {
    q: 'Can I self-host these projects?',
    a: 'Yes — self-hosting is the entire point. Every project is designed to run on your own infrastructure, whether that is a single laptop, a homelab, or a fleet of edge nodes. There is no required SaaS backend and nothing phones home to a vendor.',
  },
  {
    q: 'What programming languages are the projects written in?',
    a: 'dotcommoners builds primarily in performance-first systems languages — Rust and Zig — and uses Python where an ergonomic control plane and a rich ecosystem matter. RevenProx is written in Zig; Machineuse is written in Python.',
  },
  {
    q: 'What projects does dotcommoners publish?',
    a: 'Two public projects today: Machineuse, a distributed container manager for browser automation at scale (Python, brokerless NNG messaging, snapshot-based dormancy); and RevenProx, a high-performance Server-Sent Events proxy (Zig, designed for 10M+ concurrent connections across a brokerless NNG mesh with JWT auth and topic-based routing). More systems software in Rust, Zig, and Python is in development.',
  },
  {
    q: 'How is this different from a managed SaaS product?',
    a: 'A SaaS product runs on the vendor’s servers, meters you by seat, connection, or request, and controls the roadmap and your data. dotcommoners projects run on your servers, cost only the hardware you already own, and can be forked and modified freely. You trade a managed dependency for full ownership and control.',
  },
  {
    q: 'Is there any vendor lock-in?',
    a: 'No. The code is MIT-licensed and self-hostable with no proprietary control plane. If dotcommoners disappeared tomorrow, you would still have the full source and could keep running and maintaining it indefinitely.',
  },
  {
    q: 'How do I get started?',
    a: 'Pick a project from the projects page, open its GitHub repository, and follow the README and quick-start. Full documentation lives at docs.dotcommoners.com. Each project is built to be cloned and run on your own hardware.',
  },
  {
    q: 'How do I contribute?',
    a: 'Browse the GitHub organization at github.com/dotcommoners, pick a project, get it running locally using the docs, then open an issue or a pull request. Each repository has its own contributing notes. You can also email contact@dotcommoners.com.',
  },
  {
    q: 'What does "brokerless" mean, and why does it keep coming up?',
    a: 'It means there is no central message broker that every message passes through. Both published projects have their nodes peer directly over an NNG mesh instead, so each node decides where a message goes using a shared view of who is listening. The gain is that no single component has to be sized for the whole fleet\u2019s peak. The cost is real too: a live mesh gives you no durable retention, no replay and no total ordering, so a workload that needs those is better served by keeping a broker. The full argument is on the brokerless architecture page.',
  },
  {
    q: 'Do the projects share code or a runtime?',
    a: 'No. Machineuse and RevenProx are separate services in different languages with a network boundary between them, not modules of one system. They share design decisions — brokerless NNG coordination, MIT licensing, self-hosting as the default deployment model — rather than a codebase. You can run either on its own without the other, and most people will only ever want one of them.',
  },
  {
    q: 'Is there a hosted version I can try without installing anything?',
    a: 'No. There is no SaaS offering, no free tier and no managed control plane, which is a deliberate position rather than something still on a roadmap. Evaluating either project means running it, which is why both are designed so that a single node is a realistic starting point: Machineuse comes up as a one-node cluster under Docker Compose, and RevenProx is one static binary you can run on a laptop before deciding whether a mesh is worth it.',
  },
  {
    q: 'Who is dotcommoners for?',
    a: 'Platform engineers building internal platforms, self-hosters and homelabbers who run their own services, and systems-minded developers who want auditable, self-hosted building blocks instead of another metered dependency.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<BaseLayout
  title={title}
  description={description}
  keywords={keywords}
  path="faq"
  jsonLd={[orgSchema, websiteSchema, breadcrumbSchema(crumbs), faqSchema]}
>
  <section class="hero">
    <div class="wrap">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">FAQ</span>
      <h1>Frequently asked questions</h1>
      <p class="lede">
        Everything you might want to know about dotcommoners — what it is, how the licensing
        works, self-hosting, the tech, and how to contribute.
      </p>
      <div class="answer" style="max-width:46rem; margin-top:2.2rem;">
        <span class="lbl">The short version</span>
        <p>
          dotcommoners is an open-source (MIT) organization building self-hostable infrastructure
          in Rust, Zig, and Python. Everything runs on your own hardware with no vendor lock-in.
          Public projects: Machineuse (browser automation) and RevenProx (SSE proxy).
        </p>
      </div>
    </div>
  </section>

  <hr class="hr" />

  <section>
    <div class="wrap">
      <div class="faq" style="max-width:48rem;">
        {faqs.map((f) => (
          <details>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>

      <div class="answer" style="margin-top:2.6rem; max-width:48rem;">
        <span class="lbl">Longer answers</span>
        <p>
          Several of these questions have a full write-up behind them:
          <a href="/licensing">what MIT licensing actually grants and withholds</a>,
          <a href="/self-hosting">what self-hosting commits you to operationally</a>,
          <a href="/vs-saas">how that compares with a managed service</a>, and
          <a href="/languages">why the projects use different languages</a>.
        </p>
      </div>

      <div class="answer" style="margin-top:1.2rem; max-width:48rem;">
        <span class="lbl">Still have questions?</span>
        <p>
          Read the full <a href={DOCS}>documentation</a>, browse the source on
          <a href={GITHUB_ORG}> GitHub</a>, or <a href="/contact">get in touch</a> —
          email <a href={`mailto:${CONTACT}`}>{CONTACT}</a>.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
